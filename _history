anded=\"2\" _input_init=\"true\"></mutation><field name=\"effect\">effects.disintegrate</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"/D(I2%pM/~K80$G1)mF2\">o</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">200</field></shadow></value><next><block type=\"hudChangeLifeBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">-1</field></shadow></value><next><block type=\"controls_if\"><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">LTE</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"hudLife\"></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></value><statement name=\"DO0\"><block type=\"gameOver\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"1\" _input_init=\"true\"></mutation><field name=\"effect\">effects.melt</field><value name=\"win\"><shadow type=\"toggleWinLose\"><field name=\"win\">false</field></shadow></value></block></statement></block></next></block></next></block></statement></block></xml>","main.ts":"/**\n * To Do List\n * \n * -Create the player sprite\n * \n * -Create the key sprite\n * \n * -Create the door sprite\n * \n * -Add key collection logic\n * \n * -Add door logic\n * \n * -Add obstacles\n * \n * -Add collision logic for obstacles\n */\n/**\n * Challenge One:\n * \n * - Create moving Obstacles\n * \n * Challenge Two:\n * \n * -Make it so you have to bring the key to the door to end the game.\n */\n/**\n * <-- Creates Obstacles to dodge\n */\n// Player hits obstacle\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Enemy, function (p, o) {\n    o.destroy(effects.disintegrate, 200)\n    info.changeLifeBy(-1)\n    if (info.life() <= 0) {\n        game.over(false, effects.melt)\n    }\n})\n// Player overlaps key\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Food, function (p, k) {\n    k.destroy()\n    hasKey = true\n    game.splash(\"You got the key!\")\n    // Random reward feature\n    if (Math.percentChance(50)) {\n        info.changeScoreBy(5)\n        game.splash(\"Bonus 5 points!\")\n    } else {\n        effects.confetti.startScreenEffect(500)\n    }\n    // Respawn the key in a new random location (optional)\n    key = sprites.create(img`\n        . . 5 5 5 . . \n        . 5 7 7 7 5 . \n        5 7 7 7 7 7 5 \n        5 7 7 7 7 7 5 \n        5 7 7 7 7 7 5 \n        . 5 7 7 7 5 . \n        . . 5 5 5 . . \n        `, SpriteKind.Food)\n    key.setPosition(Math.randomRange(10, 150), Math.randomRange(10, 110))\n})\n/**\n * <-- Controls what happens when you bring the key to the door.\n */\n// Player overlaps door\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Projectile, function (p, d) {\n    if (hasKey) {\n        d.destroy()\n        game.over(true, effects.starField)\n    } else {\n        game.splash(\"You need the key!\")\n    }\n})\nlet obstacle: Sprite = null\nlet hasKey = false\nlet key: Sprite = null\n// Game setup\nscene.setBackgroundColor(7)\n// Create player\nlet player3 = sprites.create(assets.image`guy`, SpriteKind.Player)\ncontroller.moveSprite(player3)\nplayer3.setFlag(SpriteFlag.StayInScreen, true)\n// Create door (goal)\nlet door = sprites.create(assets.image`door`, SpriteKind.Projectile)\ndoor.setPosition(150, 60)\n// Create key\nkey = sprites.create(assets.image`coin`, SpriteKind.Food)\nkey.setPosition(20, 60)\n// Start countdown timer\ninfo.startCountdown(20)\n// Add obstacles to make game harder\ngame.onUpdateInterval(1000, function () {\n    obstacle = sprites.create(assets.image`Obstacle`, SpriteKind.Enemy)\n    obstacle.setPosition(Math.randomRange(10, 150), 0)\n    obstacle.vy = Math.randomRange(30, 60)\n    obstacle.setFlag(SpriteFlag.AutoDestroy, true)\n})\n","README.md":" ","assets.json":"","images.g.jres":"{\n    \"image1\": {\n        